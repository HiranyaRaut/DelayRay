# DelayRay Configuration Environment Variables

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=5173

# Application Security
JWT_SECRET=supersecret-delayray-dev-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Mode
DEMO_MODE=true
SHOW_SYNTHETIC_BADGE=true

# Database Connection (SQLite WAL mode by default; postgresql://user:pass@localhost:5432/delayray supported)
DATABASE_URL=sqlite:///./delayray.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://localhost:3000

# Local LLM & Ollama Configuration
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=60
LLM_FALLBACK_MODE=deterministic

# Vector Store (Chroma or FAISS)
VECTOR_STORE_TYPE=faiss
VECTOR_INDEX_PATH=./ml_artifacts/remarks_index

# ML Pipeline & Seeds
RANDOM_SEED=42
CHUNK_SIZE=500
OPTUNA_TRIALS=40
EVAL_TEST_START_YEAR=2019
